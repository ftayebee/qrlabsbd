# Public URL of the Nuxt site (used for canonical URLs, sitemap, Sanctum origin)
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# Domain encoded into dynamic QR codes (must route /r/* to Laravel)
NUXT_PUBLIC_SHORT_DOMAIN=http://localhost:3000
# Server-side only: how the Nuxt server reaches Laravel
NUXT_API_INTERNAL_URL=http://127.0.0.1:8000
