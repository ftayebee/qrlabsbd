# Copy to .env and fill in. Never commit the real file. Everything here is
# optional for a first boot, but dynamic QR codes encode SHORT_DOMAIN, so set the
# URLs before printing any.

# Build from this checkout. Remove to build from the public GitHub repository.
BUILD_CONTEXT=.

APP_PUBLIC_URL=https://qrio.example.com
SHORT_DOMAIN=https://qrio.example.com
HTTP_PORT=80

# First super admin, created when the database is first seeded.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Leave blank to generate and keep random values on the qrio-secrets volume.
APP_KEY=
MYSQL_PASSWORD=
REDIS_PASSWORD=
MYSQL_DATABASE=qrio
MYSQL_USER=qrio

# Mail. The default "log" mailer sends nothing.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com

# Billing. Without these, the free plan and manual plan grants still work.
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
