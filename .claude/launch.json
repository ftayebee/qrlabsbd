{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "php",
      "runtimeArgs": ["backend/artisan", "serve", "--host=127.0.0.1", "--port=8100"],
      "port": 8100,
      "autoPort": false
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
